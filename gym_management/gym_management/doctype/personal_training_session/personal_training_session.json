{
  "doctype": "DocType",
  "name": "Personal Training Session",
  "module": "Gym Management",
  "custom": 0,
  "engine": "InnoDB",
  "field_order": [
    "member",
    "member_name",
    "trainer",
    "trainer_name",
    "session_date",
    "start_time",
    "duration_minutes",
    "end_time",
    "membership",
    "status",
    "notes"
  ],
  "fields": [
    {
      "fieldname": "member",
      "fieldtype": "Link",
      "label": "Member",
      "options": "Gym Member",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "member_name",
      "fieldtype": "Data",
      "label": "Member Name",
      "fetch_from": "member.member_name",
      "read_only": 1
    },
    {
      "fieldname": "trainer",
      "fieldtype": "Link",
      "label": "Trainer",
      "options": "Gym Trainer",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "trainer_name",
      "fieldtype": "Data",
      "label": "Trainer Name",
      "fetch_from": "trainer.trainer_name",
      "read_only": 1
    },
    {
      "fieldname": "session_date",
      "fieldtype": "Date",
      "label": "Session Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "start_time",
      "fieldtype": "Time",
      "label": "Start Time",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "duration_minutes",
      "fieldtype": "Int",
      "label": "Duration (minutes)",
      "reqd": 1,
      "default": "60"
    },
    {
      "fieldname": "end_time",
      "fieldtype": "Time",
      "label": "End Time",
      "read_only": 1,
      "description": "Computed from the start time and duration."
    },
    {
      "fieldname": "membership",
      "fieldtype": "Link",
      "label": "Membership",
      "options": "Gym Membership",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Scheduled\nCompleted\nCancelled",
      "default": "Scheduled",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Notes"
    }
  ],
  "autoname": "format:PT-{####}",
  "title_field": "member_name",
  "search_fields": "member_name,trainer_name",
  "sort_field": "session_date",
  "sort_order": "DESC",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Gym Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Front Desk",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "print": 1
    },
    {
      "role": "Trainer",
      "read": 1,
      "write": 1,
      "report": 1
    }
  ]
}
