{
  "doctype": "DocType",
  "name": "Gym Trainer",
  "module": "Gym Management",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "format:TRN-{####}",
  "field_order": [
    "trainer_name",
    "employee",
    "email",
    "phone",
    "specialties",
    "bio",
    "is_active"
  ],
  "fields": [
    {
      "label": "Trainer Name",
      "fieldtype": "Data",
      "fieldname": "trainer_name",
      "reqd": 1,
      "fetch_from": "employee.employee_name",
      "read_only": 1
    },
    {
      "label": "Employee",
      "fieldtype": "Link",
      "fieldname": "employee",
      "options": "Employee",
      "reqd": 1,
      "unique": 1
    },
    {
      "label": "Email",
      "fieldtype": "Data",
      "fieldname": "email",
      "options": "Email"
    },
    {
      "label": "Phone",
      "fieldtype": "Data",
      "fieldname": "phone"
    },
    {
      "fieldname": "bio",
      "fieldtype": "Text Editor",
      "label": "Bio"
    },
    {
      "label": "Specialties",
      "fieldtype": "Table MultiSelect",
      "fieldname": "specialties",
      "options": "Gym Trainer Specialty"
    },
    {
      "label": "Is Active",
      "fieldtype": "Check",
      "fieldname": "is_active",
      "default": "1"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Gym Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Front Desk",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Trainer",
      "read": 1
    }
  ],
  "allow_rename": 1,
  "sort_field": "modified",
  "sort_order": "DESC"
}
