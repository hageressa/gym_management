{
  "doctype": "DocType",
  "name": "Gym Room",
  "module": "Gym Management",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "format:ROOM-{####}",
  "field_order": [
    "room_name",
    "capacity",
    "location",
    "is_active"
  ],
  "fields": [
    {
      "label": "Room Name",
      "fieldtype": "Data",
      "fieldname": "room_name",
      "reqd": 1
    },
    {
      "label": "Capacity",
      "fieldtype": "Int",
      "fieldname": "capacity",
      "reqd": 1
    },
    {
      "label": "Location",
      "fieldtype": "Data",
      "fieldname": "location"
    },
    {
      "label": "Is Active",
      "fieldtype": "Check",
      "fieldname": "is_active",
      "default": "1"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Gym Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Front Desk",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Trainer",
      "read": 1
    }
  ],
  "allow_rename": 1,
  "sort_field": "modified",
  "sort_order": "DESC"
}
