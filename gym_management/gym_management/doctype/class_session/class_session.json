{
  "doctype": "DocType",
  "name": "Class Session",
  "module": "Gym Management",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "format:SESS-{####}",
  "field_order": [
    "gym_class",
    "trainer",
    "room",
    "session_date",
    "start_time",
    "end_time",
    "capacity",
    "booked_count",
    "status"
  ],
  "fields": [
    {
      "label": "Gym Class",
      "fieldtype": "Link",
      "fieldname": "gym_class",
      "options": "Gym Class",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "label": "Trainer",
      "fieldtype": "Link",
      "fieldname": "trainer",
      "options": "Gym Trainer"
    },
    {
      "label": "Room",
      "fieldtype": "Link",
      "fieldname": "room",
      "options": "Gym Room"
    },
    {
      "label": "Session Date",
      "fieldtype": "Date",
      "fieldname": "session_date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "label": "Start Time",
      "fieldtype": "Time",
      "fieldname": "start_time",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "label": "End Time",
      "fieldtype": "Time",
      "fieldname": "end_time",
      "description": "Computed from the class duration.",
      "read_only": 1
    },
    {
      "label": "Capacity",
      "fieldtype": "Int",
      "fieldname": "capacity",
      "reqd": 1
    },
    {
      "fieldname": "booked_count",
      "fieldtype": "Int",
      "label": "Booked Count",
      "read_only": 1,
      "default": "0",
      "no_copy": 1
    },
    {
      "label": "Status",
      "fieldtype": "Select",
      "fieldname": "status",
      "options": "Scheduled\nCompleted\nCancelled",
      "default": "Scheduled"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Gym Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Front Desk",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Trainer",
      "read": 1
    }
  ],
  "allow_rename": 1,
  "sort_field": "session_date",
  "sort_order": "DESC"
}
