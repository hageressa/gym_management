{
  "doctype": "DocType",
  "name": "Gym Class",
  "module": "Gym Management",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "format:CLASS-{####}",
  "field_order": [
    "class_name",
    "category",
    "description",
    "default_trainer",
    "default_room",
    "default_capacity",
    "duration_minutes",
    "status"
  ],
  "fields": [
    {
      "label": "Class Name",
      "fieldtype": "Data",
      "fieldname": "class_name",
      "reqd": 1
    },
    {
      "label": "Description",
      "fieldtype": "Text Editor",
      "fieldname": "description"
    },
    {
      "label": "Default Trainer",
      "fieldtype": "Link",
      "fieldname": "default_trainer",
      "options": "Gym Trainer",
      "reqd": 1
    },
    {
      "label": "Default Room",
      "fieldtype": "Link",
      "fieldname": "default_room",
      "options": "Gym Room"
    },
    {
      "label": "Default Capacity",
      "fieldtype": "Int",
      "fieldname": "default_capacity",
      "reqd": 1
    },
    {
      "label": "Duration (Minutes)",
      "fieldtype": "Int",
      "fieldname": "duration_minutes",
      "default": "60"
    },
    {
      "label": "Status",
      "fieldtype": "Select",
      "fieldname": "status",
      "options": "Active\nInactive",
      "default": "Active"
    },
    {
      "fieldname": "category",
      "fieldtype": "Select",
      "label": "Category",
      "options": "Yoga\nHIIT\nSpin\nStrength\nOther"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Gym Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Front Desk",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Trainer",
      "read": 1
    }
  ],
  "allow_rename": 1,
  "sort_field": "modified",
  "sort_order": "DESC"
}
